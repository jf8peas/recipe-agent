# --- Required ---
# `sslmode=verify-full` (not `require`) — `pg-connection-string` currently
# treats `require`/`prefer`/`verify-ca` as aliases for `verify-full` anyway,
# but warns on every connection that this will stop being true in a future
# major version. Neon's certs are properly verifiable, so `verify-full` is
# exactly today's real behavior made explicit — no functional change, just
# no more warning.
DATABASE_URL=postgres://user:pass@host-pooler.region.neon.tech/neondb?sslmode=verify-full
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Model routing (lib/agent/models.ts) ---
MODEL_DEFAULT=openai/gpt-4.1-mini
MODEL_CRITIQUE=anthropic/claude-sonnet-5
# Feature 007 (dish images) — image-generation-capable model, finalize's
# second call only, never text.
MODEL_IMAGE=google/gemini-2.5-flash-image

# --- Feature 007 (dish images) ---
# Signs short-lived image URLs (lib/image-url.ts) so <img src> can reach a
# session's images without an X-Client-Id header. Any long random string.
IMAGE_URL_SECRET=dev-secret-change-me

# --- Public ---
PUBLIC_URL=http://localhost:3000

# --- Ingredient / recipe limits ---
MAX_INGREDIENTS=50
MAX_INGREDIENT_LENGTH=80
MAX_REFINE_CYCLES=2
MAX_STAGES_PER_SESSION=60
STAGE_TIMEOUT_MS=45000

# --- Retention ---
SESSION_PURGE_DAYS=90

# --- Abuse protection ---
RATE_WINDOW_SECONDS=60
RATE_MAX_PER_WINDOW=8
DAILY_STAGES_PER_CLIENT=200
DAILY_STAGES_GLOBAL=2000

# --- Cron guard (GET /api/cron/purge) ---
CRON_SECRET=dev-secret
